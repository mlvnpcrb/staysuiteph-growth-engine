{
  "name": "@staysuite/extension",
  "version": "0.6.0",
  "private": true,
  "displayName": "StaySuite Growth Engine",
  "description": "Account-scoped group library, approved Direct campaigns, and owner-enabled scheduled runs with background wakeups.",
  "author": "StaySuite",
  "scripts": {
    "dev": "node ../../scripts/build-extension-style.mjs && plasmo dev --target=chrome-mv3 --serve-host localhost --hmr-host localhost",
    "build": "node ../../scripts/build-extension-style.mjs && plasmo build --target=chrome-mv3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@staysuite/types": "workspace:*",
    "@staysuite/validation": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@staysuite/backend": "workspace:*",
    "@supabase/supabase-js": "2.95.3",
    "@staysuite/database": "workspace:*",
    "@staysuite/ui": "workspace:*",
    "lucide-react": "0.563.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "plasmo": "0.90.5"
  },
  "manifest": {
    "permissions": [
      "alarms",
      "scripting",
      "storage"
    ],
    "host_permissions": [],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
    },
    "optional_host_permissions": [
      "https://www.facebook.com/*",
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://kqjqcahysbmsaxlaipub.supabase.co/*"
    ],
    "optional_permissions": [
      "cookies",
      "tabs"
    ],
    "key": ""
  }
}
