{
  "name": "@staysuite/extension",
  "version": "0.1.0",
  "private": true,
  "displayName": "StaySuite Growth Engine",
  "description": "Sync visible joined-group names and links from your Facebook tab into your signed-in StaySuite account. No posting.",
  "author": "StaySuite",
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3 --serve-host localhost --hmr-host localhost",
    "build": "plasmo build --target=chrome-mv3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@staysuite/types": "workspace:*",
    "@staysuite/validation": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "plasmo": "0.90.5"
  },
  "manifest": {
    "permissions": [
      "scripting"
    ],
    "host_permissions": [],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
    },
    "optional_host_permissions": [
      "https://www.facebook.com/*",
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
